      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "pv-postgres"
      },
      "targets": [
        {
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT timestamp AS time, openai_cost AS cost FROM conversations WHERE openai_cost > 0 ORDER BY timestamp",
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "pv-postgres"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
