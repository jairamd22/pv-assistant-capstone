# --- Required ---
OPENAI_API_KEY=sk-your-key-here

# --- LLM / embeddings ---
OPENAI_MODEL=gpt-4o-mini
EVAL_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
AGENT_MAX_ITERS=6

# --- AEMS access ---
# fixture = bundled offline data (deterministic demos, no network)
# live    = openFDA backward-compatible endpoint (AEMS transition path)
AEMS_MODE=fixture
OPENFDA_API_KEY=            # optional, raises openFDA rate limits

# --- Retrieval backend ---
# memory   = in-memory keyword search (no infra; dev/baseline)
# pgvector = hybrid semantic+keyword in Postgres (production; run ingestion first)
SEARCH_BACKEND=memory

# --- Postgres ---
POSTGRES_HOST=postgres
POSTGRES_DB=pv_assistant
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# --- Ports ---
APP_PORT=8000
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin
TZ=America/Los_Angeles
